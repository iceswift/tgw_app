<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:id="@+id/label_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="THAI GOLD VIEW"
        android:textColor="#D4AF37"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="--:-- --"
        android:textColor="#888888"
        android:textSize="9sp" />

    <!-- Bullion Section (Row 1) -->
    <TextView
        android:id="@+id/label_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_title"
        android:layout_marginTop="12dp"
        android:text="แท่ง"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Bullion Sell (Right) -->
    <TextView
        android:id="@+id/widget_bullion_sell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_bar"
        android:layout_alignParentEnd="true"
        android:text="--"
        android:textColor="#D4AF37"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sep_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_bar"
        android:layout_toStartOf="@id/widget_bullion_sell"
        android:layout_marginHorizontal="4dp"
        android:text="/"
        android:textColor="#444444"
        android:textSize="12sp" />

    <!-- Bullion Buy (Left of Sell) -->
    <TextView
        android:id="@+id/widget_bullion_buy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_bar"
        android:layout_toStartOf="@id/sep_bar"
        android:text="--"
        android:textColor="#D4AF37"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Ornament Section (Row 2) -->
    <TextView
        android:id="@+id/label_orn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_bar"
        android:layout_marginTop="4dp"
        android:text="รูปพรรณ"
        android:textColor="#BBBBBB"
        android:textSize="10sp" />

    <!-- Ornament Sell (Right) -->
    <TextView
        android:id="@+id/widget_ornament_sell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_orn"
        android:layout_alignParentEnd="true"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sep_orn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_orn"
        android:layout_toStartOf="@id/widget_ornament_sell"
        android:layout_marginHorizontal="4dp"
        android:text="/"
        android:textColor="#444444"
        android:textSize="10sp" />

    <!-- Ornament Buy (Left of Sell) -->
    <TextView
        android:id="@+id/widget_ornament_buy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/label_orn"
        android:layout_toStartOf="@id/sep_orn"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Footer: Change -->
    <TextView
        android:id="@+id/label_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:text="CHANGE"
        android:textColor="#666666"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>
